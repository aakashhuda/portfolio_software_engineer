---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Portfolio' } = Astro.props;
const siteTitle = 'Syed Mahbubul Huda';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Syed Mahbubul Huda, software engineer." />
    <title>{title === siteTitle ? title : `${title} — ${siteTitle}`}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <a href="mailto:you@example.com">you@example.com</a>
    </footer>
  </body>
</html>
