---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);

const experience = [
  {
    role: "Software Engineer",
    company: "Ichiban Autos",
    dates: "2024 — Present",
    location: "New Zealand (remote)",
    url: "https://www.workshoplogic.com/",
    tone: "accent",
    focus: [
      "Python",
      "Django",
      "Django Rest Framework",
      "Vue",
      "PostgreSQL",
      "Xero",
      "Redis",
      "Tailwind",
    ],
    highlights: [
      "Built procurement system with Invoice, Credit Note, Prepayment & Invoice payments.",
      "RBAC - Role based Access Control.",
      "Invoice & Payment sync with Xero (Statistic software).",
      "Customer chat functionality.",
      "Banking Screen with Analytics.",
      "VCLOUD POS integration.",
    ],
  },
  {
    role: "Software Engineer",
    company: "EchoLogyx",
    dates: "2022 — 2024",
    location: "Chattogram",
    url: "https://www.echologyx.com/",
    tone: "signal",
    focus: ["Vanilla JS", "HTML", "CSS", "Shopify", "A/B Testing", "Django"],
    highlights: [
      "Led a team to develop a Shopify theme for the site Ninety Percent with custom functionality, an Ecommerce application.",
      "Built the Admin Panel of ELX ChatBot which is a Personalized AI-powered ChatBot for eCommerce.",
      "Shipped A/B tests on live. Learned the overall action of A/B Test.",
      "Refactored the complete backend of a Django based project named Proofly.",
    ],
  },
  {
    role: "Fullstack Developer",
    company: "SyncDots",
    dates: "2021 — 2022",
    location: "Chatttogram",
    url: "https://syncdots.id/",
    tone: "success",
    focus: [
      "Python",
      "Django",
      "Django Rest Framework",
      "Vue",
      "PostgreSQL",
      "Redis",
      "Bootstrap",
    ],
    highlights: [
      "Developed a complete Ecommerce website with Admin Panel and Production Panel.",
      "Worked on creating Admin functionalities through Telegram using BotFather",
      "Developed features for InstaPrivat like Analytics, integrating Flip (Indonesian financial technology platform for transfer).",
      "Integrated Sendgrid as SMTP server.",
      "Integrated Stripe for online payments.",
    ],
  },
];
---

<BaseLayout title="Home">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syed Mahbubul Huda" />
    <meta
      property="og:title"
      content="Syed Mahbubul Huda — Software Engineer"
    />
    <meta
      property="og:description"
      content="Syed Mahbubul Huda, software engineer with 5+ years of production experience of delivering Web Applications"
    />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site).href}
    />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="Syed Mahbubul Huda — Software Engineer"
    />
    <meta
      name="twitter:description"
      content="Syed Mahbubul Huda, software engineer with 5+ years of production experience of delivering Web Applications"
    />
  </Fragment>
  <section class="hero site-shell" id="about">
    <figure class="hero__portrait">
      <img
        src="/portrait.webp"
        alt="Portrait of Syed Mahbubul Huda"
        width="2520"
        height="3360"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <span class="hero__portrait-dot" aria-hidden="true"></span>
        Software Engineer
      </figcaption>
    </figure>
    <div class="stack">
      <h1 class="hero__name">Syed Mahbubul Huda</h1>
      <p class="hero__lead">
        Beneath the quiet water, a fish swims unaware — never knowing what lies
        beyond the surface...I provide abstract solution to real life problems.
      </p>
      <div class="cluster hero__actions">
        <a class="button button--accent" href="#projects">View projects</a>
        <a
          class="button button--github"
          href="https://github.com/aakashhuda"
          target="_blank"
          rel="noopener"
        >
          GitHub
        </a>
        <a
          class="button button--linkedin"
          href="https://www.linkedin.com/in/sm-huda/"
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="tech-stack" aria-label="Technologies">
    <div class="tech-stack__track" aria-hidden="true">
      <div class="tech-stack__group">
        {
          [
            "Python",
            "Django",
            "Django Rest Framework",
            "Vue",
            "PostgreSQL",
            "Redis",
            "Tailwind",
            "Shopify",
            "Vanilla JS",
            "HTML",
            "CSS",
            "Bootstrap",
          ].map((tech) => <span class="tech-stack__item">{tech}</span>)
        }
      </div>
      <div class="tech-stack__group">
        {
          [
            "Python",
            "Django",
            "Django Rest Framework",
            "Vue",
            "PostgreSQL",
            "Redis",
            "Tailwind",
            "Shopify",
            "Vanilla JS",
            "HTML",
            "CSS",
            "Bootstrap",
          ].map((tech) => <span class="tech-stack__item">{tech}</span>)
        }
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="site-shell">
      <h2 class="reveal reveal--line">Projects</h2>
      {
        projects.length > 0 ? (
          <div class="grid grid-cards">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>Project case studies land here in Phase 2.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="experience">
    <div class="site-shell stack">
      <h2 class="reveal reveal--line">Experience</h2>
      <div class="experience-zone reveal reveal--frame">
        {
          experience.map((item, index) => (
            <div class="experience-float" style={`--i: ${index}`}>
              <ExperienceItem {...item} index={index} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .experience-zone {
    background: var(--color-accent-soft);
    border: var(--border-thick) solid var(--color-ink);
    box-shadow: var(--shadow-sm);
    padding: var(--space-7);

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));

    gap: var(--space-7);
  }

  .experience-float {
    position: relative;

    animation: experience-drift 12s ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -3s);
  }

  .experience-float:nth-child(3n + 1) {
    animation-duration: 14s;
  }

  .experience-float:nth-child(3n + 2) {
    animation-duration: 16s;
  }

  .experience-float:nth-child(3n) {
    animation-duration: 13s;
  }

  .experience-float:hover {
    animation-play-state: paused;
  }

  @keyframes experience-drift {
    0% {
      left: 0;
      top: 0;
    }

    50% {
      left: 22px;
      top: -16px;
    }

    100% {
      left: -18px;
      top: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-float {
      animation: none;
    }
  }
</style>
