---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const experience = [
  {
    role: "Software Engineer",
    company: "Ichiban Autos",
    dates: "2024 — Present",
    location: "New Zealand (remote)",
    url: "https://www.workshoplogic.com/",
    tone: "accent",
    focus: [
      "Python",
      "Django",
      "Django Rest Framework",
      "Vue",
      "PostgreSQL",
      "Xero",
      "Redis",
      "Tailwind",
    ],
    highlights: [
      "Built procurement system with Invoice, Credit Note, Prepayment & Invoice payments.",
      "RBAC - Role based Access Control.",
      "Invoice & Payment sync with Xero (Statistic software).",
      "Customer chat functionality.",
      "Banking Screen with Analytics.",
      "VCLOUD POS integration.",
    ],
  },
  {
    role: "Software Engineer",
    company: "EchoLogyx",
    dates: "2022 — 2024",
    location: "Chattogram",
    url: "https://www.echologyx.com/",
    tone: "signal",
    focus: ["Vanilla JS", "HTML", "CSS", "Shopify", "A/B Testing", "Django"],
    highlights: [
      "Led a team to develop a Shopify theme for the site Ninety Percent with custom functionality, an Ecommerce application.",
      "Built the Admin Panel of ELX ChatBot which is a Personalized AI-powered ChatBot for eCommerce.",
      "Shipped A/B tests on live. Learned the overall action of A/B Test.",
      "Refactored the complete backend of a Django based project named Proofly.",
    ],
  },
  {
    role: "Fullstack Developer",
    company: "SyncDots",
    dates: "2021 — 2022",
    location: "Chatttogram",
    url: "https://syncdots.id/",
    tone: "success",
    focus: [
      "Python",
      "Django",
      "Django Rest Framework",
      "Vue",
      "PostgreSQL",
      "Redis",
      "Bootstrap",
    ],
    highlights: [
      "Developed a complete Ecommerce website with Admin Panel and Production Panel.",
      "Worked on creating Admin functionalities through Telegram using BotFather",
      "Developed features for InstaPrivat like Analytics, integrating Flip (Indonesian financial technology platform for transfer).",
      "Integrated Sendgrid as SMTP server.",
      "Integrated Stripe for online payments.",
    ],
  },
];
---

<BaseLayout title="Home">
  <section class="hero site-shell" id="about">
    <figure class="hero__portrait">
      <img
        src="/portrait.webp"
        alt="Portrait of Syed Mahbubul Huda"
        width="2520"
        height="3360"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <span class="hero__portrait-dot" aria-hidden="true"></span>
        Software Engineer
      </figcaption>
    </figure>
    <div class="stack">
      <h1 class="hero__name">Syed Mahbubul Huda</h1>
      <p class="hero__lead">
        Beneath the quiet water, a fish swims unaware — never knowing what lies
        beyond the surface...I provide abstract solution to real life problems.
      </p>
      <div class="cluster hero__actions">
        <a class="button button--accent" href="#projects">View projects</a>
        <a
          class="button"
          href="https://github.com/aakashhuda"
          target="_blank"
          rel="noopener"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="site-shell">
      <h2 class="reveal reveal--line">Projects</h2>
      {
        projects.length > 0 ? (
          <div class="grid grid-cards">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>Project case studies land here in Phase 2.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="experience">
    <div class="site-shell stack">
      <h2 class="reveal reveal--line">Experience</h2>
      <div class="stack">
        {
          experience.map((item, index) => (
            <ExperienceItem {...item} index={index} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
