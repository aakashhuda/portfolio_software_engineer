---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const experience = [
  {
    role: 'Software Engineer',
    company: 'Ichiban Autos — WorkshopLogic',
    dates: '2024 — Present',
    location: 'Remote',
    url: 'https://www.workshoplogic.com/',
    tone: 'accent',
    focus: ['Django', 'Vue', 'PostgreSQL', 'Xero', 'Supplier APIs'],
    highlights: [
      'Shipping full-stack features for a vertical SaaS used by auto-repair workshops.',
      'Owning invoice correctness — license-plate lookups, OCR, and barcode scans feeding one ledger.',
      'Integrating Xero and supplier systems so the tool fits existing shop workflows.',
    ],
  },
  {
    role: 'Software Engineer',
    company: 'EchoLogyx',
    dates: '2022 — 2024',
    location: 'Remote',
    url: 'https://www.echologyx.com/',
    tone: 'signal',
    focus: ['Shopify', 'A/B Testing', 'VWO', 'Convert', 'QA'],
    highlights: [
      'Built Ninety Percent and ELX ChatBot alongside the client engineering team.',
      'Shipped A/B tests on live, high-traffic storefronts — isolated, rollback-safe, reviewable.',
      'Learned to treat experiment velocity as a reliability problem, not just a conversion one.',
    ],
  },
  {
    role: 'Software Engineer',
    company: 'SyncDots & InstaPrivat',
    dates: '2021 — 2022',
    location: 'Remote',
    url: 'https://syncdots.id/',
    tone: 'success',
    focus: ['Python', 'WhatsApp API', 'Automation', 'CRM', 'Lead Gen'],
    highlights: [
      'Built the messaging-automation layer: idempotent sends, scheduling, and auto-replies.',
      'Modeled WhatsApp webhook failures honestly — retries, timeouts, and partial failures.',
      'Deep-linked WhatsApp inquiries for InstaPrivat so context survived the handoff.',
    ],
  },
];
---

<BaseLayout title="Home">
  <section class="hero site-shell" id="about">
    <figure class="hero__portrait">
      <img
        src="/portrait.webp"
        alt="Portrait of Syed Mahbubul Huda"
        width="2520"
        height="3360"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <span class="hero__portrait-dot" aria-hidden="true"></span>
        Software Engineer
      </figcaption>
    </figure>
    <div class="stack">
      <h1 class="hero__name">Syed Mahbubul Huda</h1>
      <p class="hero__lead">
        Software engineer with five years shipping real products across
        Python, Django, FastAPI, Vue, Nuxt, and Astro — now focused on
        agentic development.
      </p>
      <div class="cluster hero__actions">
        <a class="button button--accent" href="#projects">View projects</a>
        <a class="button" href="https://github.com/aakashhuda" target="_blank" rel="noopener">
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="site-shell">
      <h2 class="reveal reveal--line">Projects</h2>
      {projects.length > 0 ? (
        <div class="grid grid-cards">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
      ) : (
        <div class="empty-state">
          <p>Project case studies land here in Phase 2.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="experience">
    <div class="site-shell stack">
      <h2 class="reveal reveal--line">Experience</h2>
      <div class="stack">
        {experience.map((item, index) => <ExperienceItem {...item} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>
